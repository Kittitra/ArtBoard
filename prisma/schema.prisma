// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  scriptOwner Script[]
  projectMembers UserProject[]
  DesignCategoryOwner DesignCategory[]
  DesignOwner DesignSubClass[]
  AnimationOwner Animation[]
  FootageOwner Footage[]
  SoundOwner Sound[]
  soundFolderOwner SoundFolder[]
  edited Edited[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectMembers UserProject[]
  scripts      Script[]
  designCategories DesignCategory[]
  animationCategories AnimationState[]
  footageCategories FootageState[]
  soundFolders SoundFolder[]
  sounds Sound[]
  storyboards Storyboard[]
  edited EditedState[]
}
//script-----------------------------------------------------------------------------------------------------------------------------------
model Script {
  id          String   @id @default(uuid())
  title       String
  description String?
  author      String?  // ชื่อผู้เขียนบน cover page

  // เก็บ Tiptap JSON ทั้งหมดเป็น Json
  content     Json     @default("{}")

  // metadata
  status      ScriptStatus @default(DRAFT)
  version     Int          @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId      String
  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String?
  project Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scenes      Scene[]
  storyborad  Storyboard[]

  @@index([ownerId])
}

// แยก Scene ออกมาเพื่อ query ได้ง่าย
model Scene {
  id          String  @id @default(uuid())
  sceneNumber Int
  heading     String  // "INT. COFFEE SHOP - DAY"
  pageStart   Int?    // หน้าที่เริ่ม

  scriptId    String
  script      Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  shot        Shot[]
  @@index([scriptId])
}

enum ScriptStatus {
  DRAFT
  IN_REVIEW
  FINAL
  ARCHIVED
}
//Design-----------------------------------------------------------------------------------------------------------------------------------
model DesignCategory {
  id          String  @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId      String
  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  designs DesignSubClass[]
}

model DesignSubClass {
  id          String  @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId      String
  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categoryId String?
  category DesignCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions    DesignSubClassVersion[]
}

model DesignSubClassVersion {
  id          String  @id @default(uuid())
  name        String
  content     Json     @default("{}") // เก็บข้อมูลการออกแบบทั้งหมดเป็น Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId      String

  DesignSubClassId String?
  DesignSubClass DesignSubClass? @relation(fields: [DesignSubClassId], references: [id], onDelete: SetNull)
}

//project-----------------------------------------------------------------------------------------------------------------------------------
model UserProject {
  userId    String  
  projectId String 

  role    String  // "owner", "editor
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}
//Animation-----------------------------------------------------------------------------------------------------------------------------------
model AnimationState {
  id          String  @id @default(uuid())
  name       String

  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  animations Animation[]
}

model Animation {
  id          String  @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approved    Boolean @default(false)
  description String?
  ownerId      String
  stateId String?
  status  String

  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  state AnimationState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  AnimationVersions AnimationVersion[]
}

model AnimationVersion {
  id            String    @id @default(uuid())
  versionNumber Int       // 1, 2, 3, ...
  label         String?   // "Version 1", "Draft 2" ฯลฯ
  muxUploadId   String?
  muxPlaybackId String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  animationId   String

  animation Animation @relation(fields: [animationId], references: [id], onDelete: Cascade)
}
//Footage-----------------------------------------------------------------------------------------------------------------------------------
model FootageState {
  id          String  @id @default(uuid())
  name       String

  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  footage Footage[]
}

model Footage {
  id          String  @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approved    Boolean @default(false)
  description String?
  ownerId      String
  stateId String?
  status  String

  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  state FootageState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  FootageVersions FootageVersion[]
}

model FootageVersion {
  id            String    @id @default(uuid())
  versionNumber Int       // 1, 2, 3, ...
  label         String?   // "Version 1", "Draft 2" ฯลฯ
  muxUploadId   String?
  muxPlaybackId String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  footageId   String

  footage Footage @relation(fields: [footageId], references: [id], onDelete: Cascade)
}

//Footage-----------------------------------------------------------------------------------------------------------------------------------
model EditedState {
  id          String  @id @default(uuid())
  name       String

  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  edited Edited[]
}

model Edited {
  id          String  @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approved    Boolean @default(false)
  description String?
  ownerId      String
  stateId String?
  status  String

  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  state EditedState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  EditedVersions EditedVersion[]
}

model EditedVersion {
  id            String    @id @default(uuid())
  versionNumber Int       // 1, 2, 3, ...
  label         String?   // "Version 1", "Draft 2" ฯลฯ
  muxUploadId   String?
  muxPlaybackId String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  editedId   String

  edited Edited @relation(fields: [editedId], references: [id], onDelete: Cascade)
}

//Sound-----------------------------------------------------------------------------------------------------------------------------------
model SoundFolder {
  id          String  @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId      String
  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentFolderId String?
  parentFolder SoundFolder? @relation("SoundFolderToSubFolders", fields: [parentFolderId], references: [id], onDelete: SetNull)
  subFolders SoundFolder[] @relation("SoundFolderToSubFolders")

  sounds Sound[]
}

model Sound {
  id          String  @id @default(uuid())
  title        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId      String
  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  folderId String?
  folder SoundFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  soundVersion SoundVersion[]
}

model SoundVersion {
  id          String  @id @default(uuid())
  title        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  soundId      String
  muxUploadId String
  muxPlaybackId String
  status String

  versionNumber Int

  sound Sound @relation(fields: [soundId], references: [id], onDelete: Cascade)
}
/////////////////////////////////////////////////////////////////////////////////////// Stortboard

model Storyboard {
  id        String   @id @default(uuid())
  title     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  scriptId  String?
  script    Script?  @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  shots     Shot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scriptId])
}

model Shot {
  id           String     @id @default(uuid())
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  order        Float      // fractional index สำหรับ drag reorder ผ่าน dnd-kit

  sceneId      String?
  scene        Scene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  shotType       ShotType?
  cameraMovement CameraMovement?
  description    String?  @db.Text
  dialogue       String?  @db.Text
  duration       Int?

  frame        Frame?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storyboardId, order])
  @@index([sceneId])
}

model Frame {
  id           String @id @default(uuid())
  shotId       String @unique
  shot         Shot   @relation(fields: [shotId], references: [id], onDelete: Cascade)

  sketchData   Json?
  imageAssetId String?
  videoAssetId String?

  updatedAt    DateTime @updatedAt
}

enum ShotType {
  WIDE
  MEDIUM
  CLOSE_UP
  EXTREME_CLOSE_UP
  OVER_THE_SHOULDER
  POV
}

enum CameraMovement {
  STATIC
  PAN
  TILT
  DOLLY
  TRACKING
  HANDHELD
}