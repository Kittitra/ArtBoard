//Assets
model Asset {
   id          String @id @default(uuid())

  projectId   String
  createdById String
  assignedToId String?

  type        AssetType
  title       String?
  status      String?

  project Project @relation(  fields: [projectId],  references: [id],  onDelete: Cascade)

  createdBy User @relation(  "AssetCreatedBy",  fields: [createdById],references: [id])

  assignedTo User? @relation("AssetAssignedTo",fields: [assignedToId],references: [id],onDelete: SetNull)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  script      Script?
  // animation   Animation?
  // footage     Footage?
  // edited      Edited?
  sound       Sound?
  storyboard  Storyboard?
  designCategory DesignCategory?



  @@index([projectId, type])
}

enum AssetType {
  SCRIPT
  ANIMATION
  FOOTAGE
  EDITED
  SOUND
  STORYBOARD
  DESIGN
}

//script-----------------------------------------------------------------------------------------------------------------------------------
model Script {
  id          String   @id @default(uuid())
  title       String
  description String?
  author      String?  // ชื่อผู้เขียนบน cover page

  // เก็บ Tiptap JSON ทั้งหมดเป็น Json
  content     Json     @default("{}")

  // metadata
  status      ScriptStatus @default(DRAFT)
  version     Int          @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetId   String?  @unique
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  storyboard  Storyboard[]

}

// แยก Scene ออกมาเพื่อ query ได้ง่าย
model Scene {
  id          String  @id @default(uuid())
  sceneNumber Int
  heading     String  // "INT. COFFEE SHOP - DAY"
  pageStart   Int?    // หน้าที่เริ่ม

  scriptId    String
  script      Script  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  shot        Shot[]
  @@index([scriptId])
}

enum ScriptStatus {
  DRAFT
  IN_REVIEW
  FINAL
  ARCHIVED
}
//Design-----------------------------------------------------------------------------------------------------------------------------------
model DesignCategory {
  id          String  @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetId   String?  @unique
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  designs DesignSubClass[]
}

model DesignSubClass {
  id          String  @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category DesignCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions    DesignSubClassVersion[]
}

model DesignSubClassVersion {
  id          String  @id @default(uuid())
  name        String
  content     Json     @default("{}") // เก็บข้อมูลการออกแบบทั้งหมดเป็น Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  DesignSubClassId String?
  DesignSubClass DesignSubClass? @relation(fields: [DesignSubClassId], references: [id], onDelete: SetNull)
}

//Animation-----------------------------------------------------------------------------------------------------------------------------------
model AnimationState {
  id          String  @id @default(uuid())
  name       String

  projectId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  animations Animation[]
  
  @@unique([projectId, name])
  @@index([projectId])
}

model Animation {
  id          String  @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approved    Boolean @default(false)
  description String?

  stateId String?
  state AnimationState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  AnimationVersions AnimationVersion[]
}

model AnimationVersion {
  id            String    @id @default(uuid())
  versionNumber Int       // 1, 2, 3, ...
  label         String?   // "Version 1", "Draft 2" ฯลฯ
  muxUploadId   String?
  muxPlaybackId String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  animationId   String

  animation Animation @relation(fields: [animationId], references: [id], onDelete: Cascade)
}
//Footage-----------------------------------------------------------------------------------------------------------------------------------
model FootageState {
  id          String  @id @default(uuid())
  name       String

  projectId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  footage Footage[]
  
  @@unique([projectId, name])
  @@index([projectId])
}

model Footage {
  id          String  @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approved    Boolean @default(false)
  description String?

  stateId String?

  state FootageState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  FootageVersions FootageVersion[]
}

model FootageVersion {
  id            String    @id @default(uuid())
  versionNumber Int       // 1, 2, 3, ...
  label         String?   // "Version 1", "Draft 2" ฯลฯ
  muxUploadId   String?
  muxPlaybackId String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  footageId   String

  footage Footage @relation(fields: [footageId], references: [id], onDelete: Cascade)
}

//Footage-----------------------------------------------------------------------------------------------------------------------------------
model EditedState {
  id          String  @id @default(uuid())
  name       String

  projectId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  edited Edited[]
  @@unique([projectId, name])
  @@index([projectId])
}

model Edited {
  id          String  @id @default(uuid())
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approved    Boolean @default(false)
  description String?

  stateId String?
  status  String

  state EditedState? @relation(fields: [stateId], references: [id], onDelete: SetNull)
  EditedVersions EditedVersion[]
}

model EditedVersion {
  id            String    @id @default(uuid())
  versionNumber Int       // 1, 2, 3, ...
  label         String?   // "Version 1", "Draft 2" ฯลฯ
  muxUploadId   String?
  muxPlaybackId String?
  thumbnailUrl  String?
  createdAt     DateTime  @default(now())
  editedId   String

  edited Edited @relation(fields: [editedId], references: [id], onDelete: Cascade)
}

//Sound-----------------------------------------------------------------------------------------------------------------------------------
model SoundFolder {
  id          String  @id @default(uuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String?  @unique
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentFolderId String?
  parentFolder SoundFolder? @relation("SoundFolderToSubFolders", fields: [parentFolderId], references: [id], onDelete: SetNull)
  subFolders SoundFolder[] @relation("SoundFolderToSubFolders")

  sounds Sound[]
}

model Sound {
  id          String  @id @default(uuid())
  title        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetId   String?  @unique
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  folderId String?
  folder SoundFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  soundVersion SoundVersion[]
}

model SoundVersion {
  id          String  @id @default(uuid())
  title        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  soundId      String
  muxUploadId String
  muxPlaybackId String
  status String

  versionNumber Int

  sound Sound @relation(fields: [soundId], references: [id], onDelete: Cascade)
}
/////////////////////////////////////////////////////////////////////////////////////// Stortboard

model Storyboard {
  id        String   @id @default(uuid())
  title     String
  assetId   String?  @unique
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  scriptId  String?
  script    Script?  @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  shots     Shot[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scriptId])
}

model Shot {
  id           String     @id @default(uuid())
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  order        Float      // fractional index สำหรับ drag reorder ผ่าน dnd-kit

  sceneId      String?
  scene        Scene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  shotType       ShotType?
  cameraMovement CameraMovement?
  description    String?  @db.Text
  dialogue       String?  @db.Text
  duration       Int?

  frame        Frame?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storyboardId, order])
  @@index([sceneId])
}

model Frame {
  id           String @id @default(uuid())
  shotId       String @unique
  shot         Shot   @relation(fields: [shotId], references: [id], onDelete: Cascade)

  sketchData   Json?
  imageAssetId String?
  videoAssetId String?

  updatedAt    DateTime @updatedAt
}

enum ShotType {
  WIDE
  MEDIUM
  CLOSE_UP
  EXTREME_CLOSE_UP
  OVER_THE_SHOULDER
  POV
}

enum CameraMovement {
  STATIC
  PAN
  TILT
  DOLLY
  TRACKING
  HANDHELD
}